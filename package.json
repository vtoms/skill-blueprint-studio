{
  "name": "skill-blueprint-studio",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Visual authoring of reviewable skill workflows",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "node studio/serve.mjs",
    "build": "node studio/build.mjs",
    "test": "node --test studio/*.test.mjs",
    "test:analyzer": "python -m unittest discover -s studio -p analyze_sources_test.py",
    "db:template": "node studio/make-database-template.mjs",
    "examples": "node studio/make-examples.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "test:all": "npm run build && npm test && npm run test:analyzer && npm run test:browser"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
